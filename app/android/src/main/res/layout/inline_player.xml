<?xml version="1.0" encoding="utf-8"?>
<!-- The article's video in place (InlineStreamPlayer): drawn in a TextureView rather than a SurfaceView, so it is part
     of the app's own drawing. A SurfaceView is a hole in the window the status bar's blur can't see through, and it
     flashes black as it is made. Full screen keeps the default SurfaceView. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/transparent" />
